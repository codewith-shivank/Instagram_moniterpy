DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
CHECK_INTERVAL_SECONDS=120
CONFIRMATION_CHECKS=2
STATE_FILE=monitor.db
# Optional: an Instagram session cookie if public profile checks require login.
# Paste only the sessionid value; URL-encoded values are accepted.
# INSTAGRAM_SESSIONID=your_instagram_session_id
INSTAGRAM_CACHE_SECONDS=60
INSTAGRAM_RETRY_COUNT=2
INSTAGRAM_RETRY_DELAY_SECONDS=2
INSTAGRAM_FETCH_LATEST_POST=0
INSTAGRAM_CHECK_TIMEOUT_SECONDS=25

